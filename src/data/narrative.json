        "heading": "Rule R3_CITIZENSHIP: Proof of citizenship",
        "lines": [
          { "text": "Tier 1. The applicant presents one of the following original documents. Photocopies are not accepted.", "level": 0 },
          { "text": "A South Dakota driver license that reads \"U.S. Citizen\" on the back.", "level": 1 },
          { "text": "A driver license or nondriver identification card from another state that indicates citizenship has been verified.", "level": 1 },
