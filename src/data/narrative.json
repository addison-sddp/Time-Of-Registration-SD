          { "text": "Birth certificate.", "level": 1 },
          { "text": "U.S. passport.", "level": 1 },
          { "text": "Consular report of birth abroad issued by the U.S. Department of State.", "level": 1 },
          { "text": "Certificate of naturalization.", "level": 1 },
          { "text": "Expired documents are not accepted. The name on the presented item must match the name on the application.", "level": 0 }
        ]
      }
